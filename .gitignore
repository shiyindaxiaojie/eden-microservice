# 编译输出
/bin
/dist
*.exe
*.dll
*.so
*.dylib
.gocache
.gomodcache

# 依赖目录
/vendor/

# IDE和编辑器文件
.idea/
.vscode/
*.swp
*.swo
*~

# 日志文件
*.log
logs/

# 配置文件（排除示例配置）
configs/*.yaml
!configs/*.yaml.example
config/config.yaml

# 环境变量文件
.env
.env.local

# 操作系统文件
.DS_Store
Thumbs.db

# 测试覆盖率报告
coverage.txt
coverage.html

# 临时文件
tmp/
temp/

# 构建缓存
.cache/

# Go特定文件
*.test
*.out

# 证书文件
*.pem
*.key
*.crt

# Helm相关
charts/
*.tgz
.helm/

# 其他
*.bak
*.backup
*.swp
*.tmp

# Frontend
apps/ui/node_modules/
apps/ui/dist/
apps/ui/.env
apps/ui/.env.*
apps/ui/npm-debug.log*
apps/ui/yarn-debug.log*
apps/ui/yarn-error.log*
apps/ui/yarn.lock

# TypeScript 编译生成的文件
apps/ui/src/**/*.js
apps/ui/src/**/*.js.map
apps/ui/src/**/*.d.ts
!apps/ui/src/**/*shims*.d.ts
!apps/ui/src/**/vite-env.d.ts
apps/ui/tsconfig.tsbuildinfo
apps/ui/*.tsbuildinfo

# Backend
.env.*
*.log
logs/

# Database
*.db
*.sqlite
*.sqlite3
data/
